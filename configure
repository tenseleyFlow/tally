#!/bin/sh
# tally configure — tiny capability probe. No autotools. Writes config.h + config.mk.
# Re-run is idempotent. Honors CC, CFLAGS, PREFIX, DESTDIR from the environment.
set -u

CC=${CC:-cc}
PREFIX=${PREFIX:-/usr/local}
tmp=$(mktemp -d 2>/dev/null || echo /tmp/tal.cfg.$$)
mkdir -p "$tmp"
trap 'rm -rf "$tmp"' EXIT

# try_compile <name> <source> <extra-cflags> -> echoes 1 if it builds, else 0
try_compile() {
	printf '%s\n' "$2" > "$tmp/t.c"
	if $CC $CFLAGS_PROBE $3 -o "$tmp/t" "$tmp/t.c" >/dev/null 2>&1; then
		echo 1
	else
		echo 0
	fi
}
CFLAGS_PROBE=${CFLAGS:-}

uname_s=$(uname -s)
echo "configure: CC=$CC  OS=$uname_s  PREFIX=$PREFIX"

# glibc under -std=c11 hides POSIX symbols (posix_fadvise, ...) behind
# __STRICT_ANSI__; _GNU_SOURCE re-exposes them. BSD/macOS expose them by default.
CONF_CFLAGS=
case "$uname_s" in
Linux) CONF_CFLAGS='-D_GNU_SOURCE' ;;
esac

# x86 SIMD. SSE2 is baseline on x86_64 (no extra flags); AVX2 code compiles into
# its own translation unit with AVX2_CFLAGS and is gated at runtime, so probing
# compiler support here is enough — the host CPU need not have AVX2.
HAS_SSE2=$(try_compile sse2 '
#include <immintrin.h>
int main(void){ __m128i v = _mm_set1_epi8(10); return _mm_movemask_epi8(v) & 1; }' '')

HAS_AVX2=$(try_compile avx2 '
#include <immintrin.h>
int main(void){ __m256i v = _mm256_set1_epi8(10); return _mm256_movemask_epi8(v) & 1; }' '-mavx2')

# Runtime AVX2 detection. gcc/clang builtin on x86; absent elsewhere.
HAS_CPU_SUPPORTS=$(try_compile cpu_supports '
int main(void){ return __builtin_cpu_supports("avx2"); }' '')

HAS_NEON=$(try_compile neon '
#include <arm_neon.h>
int main(void){ uint8x16_t v = vdupq_n_u8(10); return (int)vgetq_lane_u8(v,0); }' '')

# C11 mbrtoc32 (glibc/FreeBSD/musl; older macOS lacks <uchar.h> — fall back to
# mbrtowc, sound only where wchar_t is UTF-32).
HAS_MBRTOC32=$(try_compile mbrtoc32 '
#include <uchar.h>
#include <string.h>
int main(void){ char32_t c; mbstate_t st; memset(&st,0,sizeof st);
	return (int)mbrtoc32(&c, "a", 1, &st); }' '')

WCHAR_IS_UTF32=$(try_compile wchar32 '
#include <wchar.h>
int main(void){ _Static_assert(sizeof(wchar_t)==4, "w"); return 0; }' '')

HAS_POSIX_FADVISE=$(try_compile fadvise "
$CONF_CFLAGS
#include <fcntl.h>
int main(void){ return posix_fadvise(0, 0, 0, POSIX_FADV_SEQUENTIAL); }" "$CONF_CFLAGS")

if [ "$HAS_MBRTOC32" != 1 ] && [ "$WCHAR_IS_UTF32" != 1 ]; then
	echo "configure: WARNING: no mbrtoc32 and wchar_t is not UTF-32 — multibyte parity unavailable" >&2
fi

AVX2_CFLAGS=
[ "$HAS_AVX2" = 1 ] && AVX2_CFLAGS='-mavx2'

cat > config.h <<EOF
/* generated by ./configure — do not edit */
#ifndef TAL_CONFIG_H
#define TAL_CONFIG_H
#define TAL_OS                 "$uname_s"
#define TAL_HAS_SSE2           $HAS_SSE2
#define TAL_HAS_AVX2           $HAS_AVX2
#define TAL_HAS_CPU_SUPPORTS   $HAS_CPU_SUPPORTS
#define TAL_HAS_NEON           $HAS_NEON
#define TAL_HAS_MBRTOC32       $HAS_MBRTOC32
#define TAL_WCHAR_IS_UTF32     $WCHAR_IS_UTF32
#define TAL_HAS_POSIX_FADVISE  $HAS_POSIX_FADVISE
#endif
EOF

cat > config.mk <<EOF
# generated by ./configure — do not edit
CC = $CC
PREFIX = $PREFIX
CONF_CFLAGS = $CONF_CFLAGS
AVX2_CFLAGS = $AVX2_CFLAGS
EOF

echo "configure: sse2=$HAS_SSE2 avx2=$HAS_AVX2(compile) cpu_supports=$HAS_CPU_SUPPORTS neon=$HAS_NEON"
echo "configure: mbrtoc32=$HAS_MBRTOC32 wchar32=$WCHAR_IS_UTF32 fadvise=$HAS_POSIX_FADVISE"
echo "configure: wrote config.h, config.mk"
